{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Горн Next",
  "identifier": "com.gorn.next",
  "version": "0.1.35",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://gorn-icon.localhost gorn-icon: https://cdn.tlidb.com; connect-src 'self' ipc: http://ipc.localhost http://gorn-icon.localhost gorn-icon:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "Горн",
    "shortDescription": "Трекер валюты и подсказки в тюрьме для Torchlight: Infinite"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyMEExMkEwNTM2ODFDRjEKUldUeEhHaFRvQklLVWpJV3J3NDZmWjEvOElPYnBORHVSZkNNa3hZaVdNWE1SSE9qQndSamFDcTkK",
      "endpoints": [
        "https://github.com/lanqvist/GornNext/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
